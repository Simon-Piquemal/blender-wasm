# ---------------------------------------------------------------------------
# blender-wasm .gitignore
# Everything reproducible from `make` / the build scripts is untracked.
# Tracked = the orchestration: Makefile, scripts/, cmake/, smoke/,
# node-webgpu/*.cjs, package.json, README.md, this file.
# (The WebGPU backend + WASM patches live in the fork, pulled by `make blender`.)
# NOTE: gitignore has NO inline comments — keep `#` lines separate from patterns.
# ---------------------------------------------------------------------------

# toolchain / sources / dep trees (regenerated by make)
/emsdk/
# blender/ is VENDORED (scripts/vendor_blender.sh), not a checkout: it is a
# trimmed snapshot of the fork that we edit in place, so it IS tracked.
/deps/
/wasm-sysroot/

# CMake / ninja build dirs
/build-blender/
/build-cycles/

# npm
/node_modules/
/package-lock.json
/node-webgpu/node_modules/
/node-webgpu/package-lock.json
/mcp/node_modules/
/mcp/package-lock.json

# node + Dawn + lavapipe harness: generated module + logs + captures
/node-webgpu/blender_node.js
/node-webgpu/blender_node.wasm
/node-webgpu/blender_node.data
/node-webgpu/blender_node.js.symbols
/node-webgpu/blender_full.log
/node-webgpu/*.log
/node-webgpu/*.ppm
/node-webgpu/eevee_node_capture.*

# release tarball + demo build outputs
/blender*.tar.gz
/demo/node_modules/
# /demo/dist/ N'EST PLUS IGNORE -- c'est devenu l'artefact de deploiement.
#
# Construire Blender en wasm demande emsdk et des heures de CPU : aucun builder
# d'hebergeur ne peut le faire. Le site est donc construit ici et versionne, et
# l'image de deploiement (cf. Dockerfile, deploy/) ne fait que le servir.
#
# Contrepartie assumee : ~33 Mo par version du binaire dans l'historique. Ne
# recommiter dist/ que lorsqu'il a REELLEMENT change -- pas a chaque commit.
#
# assets.tar reste dehors : c'est la version NON compressee de assets.tar.zst,
# que rien ne va chercher au runtime (demo/src/main.js ne fetch que le .zst).
# Vite la recopie depuis public/ parce qu'elle y traine ; l'ajouter au depot
# doublerait le poids pour un fichier jamais servi.
/demo/dist/assets.tar
/demo/.stage/
/demo/public/blender.js
/demo/public/blender.wasm.zst
/demo/public/assets.tar
/demo/public/assets.tar.zst
/demo/public/manifest.json
/demo/public/wgsl-cache.json
# Intermediate: the shipped seed is the .zst beside it.
/demo/wgsl-cache.json
/demo/public/wgsl-cache.json.zst

# misc
*.o
*.a
/scratchpad/
.DS_Store
# UI iteration staging (scripts/restage_assets.sh)
/demo/.stage-ui/
/demo/.stage-ui-py/

# generated by scripts/package_numpy.sh from the numpy build
/blender/source/blender/python/intern/numpy_static_inittab.inc

# ---------------------------------------------------------------------------
# git-LFS objects inside the vendored blender/ tree.
#
# GitHub refuses LFS uploads to a public fork, which is what this repo is, so
# these cannot be pushed here at all -- the push fails with "can not upload new
# objects to public fork". scripts/fetch_lfs_datafiles.sh already exists for
# exactly this reason: it resolves the pointers from upstream by content hash,
# independently of any fork. So the binaries stay out of git and that script
# puts them back:
#
#   bash scripts/vendor_blender.sh          # the tree
#   bash scripts/fetch_lfs_datafiles.sh blender   # its LFS binaries
#
# Everything else under blender/ IS committed, including every source file this
# project edits.
# ---------------------------------------------------------------------------
/blender/release/datafiles/icons/
/blender/release/datafiles/studiolights/
/blender/release/datafiles/colormanagement/icc/
/blender/release/windows/
/blender/release/darwin/
/blender/assets/

# The rest of the LFS binaries, named individually.
/blender/doc/python_api/static/favicon.png
/blender/release/datafiles/DejaVuSans-Lite.sfd.bz2
/blender/release/datafiles/icons_blend/
/blender/release/datafiles/preview.blend
/blender/release/datafiles/preview_grease_pencil.blend
/blender/release/datafiles/splash.png
/blender/release/datafiles/startup.blend
/blender/scripts/startup/bl_app_templates_system/2D_Animation/startup.blend
/blender/scripts/startup/bl_app_templates_system/Sculpting/startup.blend
/blender/scripts/startup/bl_app_templates_system/Storyboarding/startup.blend
/blender/scripts/startup/bl_app_templates_system/VFX/
/blender/scripts/startup/bl_app_templates_system/Video_Editing/startup.blend
